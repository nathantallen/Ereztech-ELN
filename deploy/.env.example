# Copy to .env next to docker-compose.prod.yml and edit before first start.

# Database credentials (DATABASE_URL is assembled from these automatically)
POSTGRES_DB=erezops
POSTGRES_USER=erezops
# Generate one:  openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE-ME

# Flask session-signing key. Generate one:  openssl rand -hex 32
SECRET_KEY=CHANGE-ME

# Host port the app is served on (http://server:APP_PORT)
APP_PORT=8090

# Optional: SAP lookup page (read-only OData). Leave blank to hide setup on the SAP page.
SAP_BASE_URL=
SAP_USER=
SAP_PASSWORD=
SAP_CLIENT=
# Override only if your system uses different service names for BOM/stock:
# SAP_BOM_SERVICE=API_BILL_OF_MATERIAL_SRV;v=0002
# SAP_STOCK_SERVICE=API_MATERIAL_STOCK_SRV
