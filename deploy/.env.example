# Copy to .env next to docker-compose.prod.yml and edit before first start.

# Database credentials (DATABASE_URL is assembled from these automatically)
POSTGRES_DB=erezops
POSTGRES_USER=erezops
# Generate one:  openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE-ME

# Flask session-signing key. Generate one:  openssl rand -hex 32
SECRET_KEY=CHANGE-ME

# Host port the app is served on (http://server:APP_PORT)
APP_PORT=8090

# Gunicorn worker processes. Rule of thumb: (2 x CPU cores) + 1. Default 2.
# WEB_CONCURRENCY=4
